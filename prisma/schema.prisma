generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  BARBER
  ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum SubscriptionType {
  MONTH_3
  MONTH_6
  YEAR_1
  YEAR_4
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  PROMO_CODE
}

enum RecurrenceType {
  DAILY
  WEEKLY
  MONTHLY
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String    @unique
  password         String?
  image            String?
  role             Role      @default(CUSTOMER)
  twoFactorEnabled Boolean   @default(false)
  twoFactorCode    String?
  twoFactorExpires DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  profile                  Profile?
  appointmentsAsCustomer   Appointment[]             @relation("CustomerAppointments")
  sentMessages             Message[]                 @relation("SentMessages")
  receivedMessages         Message[]                 @relation("ReceivedMessages")
  blacklistedBy            Blacklist[]
  favorites                Favorite[]
  subscriptionAppointments SubscriptionAppointment[]
  supportTickets           SupportTicket[]
  ticketMessages           TicketMessage[]
  paymentTransactions      PaymentTransaction[]
}

model Profile {
  id           String  @id @default(cuid())
  slug         String  @unique
  customDomain String? @unique
  shopName     String
  bio          String?

  address   String?
  latitude  Float?
  longitude Float?

  themeConfig Json?

  subscriptionEndsAt          DateTime?
  isActive                    Boolean   @default(false)
  appointmentLimitPerCustomer Int       @default(1)
  averageRating               Float? // Ortalama puan (1-5)
  isVerified                  Boolean   @default(false)

  // Subscription appointment settings
  allowSubscriptionAppointments Boolean @default(false)
  allowedRecurrenceTypes        Json? // ["DAILY", "WEEKLY", "MONTHLY"]
  allowTimeChanges              Boolean @default(true) // Allow time changes

  photos                        String[]  @default([]) // Gallery photos (Max 6)
  logo                          String?   // Isletme logosu

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  services                 Service[]
  appointments             Appointment[]
  blacklist                Blacklist[]
  workingHours             WorkingHour[]
  breaks                   Break[]
  holidays                 Holiday[]
  subscriptions            SubscriptionHistory[]
  staff                    Staff[] // Personeller
  staffRoles               StaffRole[] // Personel rolleri
  favoritedBy              Favorite[]
  subscriptionAppointments SubscriptionAppointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkingHour {
  id        String  @id @default(cuid())
  dayOfWeek Int
  isClosed  Boolean @default(false)

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id])

  shifts Shift[] // Birden fazla vardiya icin

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, dayOfWeek])
}

model Shift {
  id        String @id @default(cuid())
  startTime String // "08:00"
  endTime   String // "12:00"

  workingHourId String
  workingHour   WorkingHour @relation(fields: [workingHourId], references: [id], onDelete: Cascade)

  staffId String? // Vardiyaya atanan personel (opsiyonel)
  staff   Staff?  @relation(fields: [staffId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

model Break {
  id        String @id @default(cuid())
  startTime String
  endTime   String
  dayOfWeek Int

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id])
}

model Holiday {
  id        String   @id @default(cuid())
  startDate DateTime
  endDate   DateTime
  reason    String?

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id])
}

model SubscriptionHistory {
  id            String           @id @default(cuid())
  type          SubscriptionType
  startDate     DateTime
  endDate       DateTime
  amount        Decimal
  paymentMethod PaymentMethod

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id])

  packageId String?
  package   Package? @relation(fields: [packageId], references: [id])

  promoCodeId String?
  promoCode   PromoCode? @relation(fields: [promoCodeId], references: [id])

  createdAt DateTime @default(now())
}

model Service {
  id       String  @id @default(cuid())
  name     String
  duration Int
  price    Decimal

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id])

  appointments             Appointment[]
  staffAssignments         StaffServiceAssignment[]
  subscriptionAppointments SubscriptionAppointment[]
}

model Appointment {
  id        String            @id @default(cuid())
  startTime DateTime
  endTime   DateTime
  status    AppointmentStatus @default(CONFIRMED)
  notes     String?

  customerId String
  customer   User   @relation("CustomerAppointments", fields: [customerId], references: [id])

  barberId String
  barber   Profile @relation(fields: [barberId], references: [id])

  staffId String? // Personel atamasi (opsiyonel)
  staff   Staff?  @relation(fields: [staffId], references: [id])

  services Service[]

  subscriptionAppointmentId String?
  subscriptionAppointment   SubscriptionAppointment? @relation(fields: [subscriptionAppointmentId], references: [id], onDelete: SetNull)

  // Randevu degisiklik onayi icin
  pendingChangeId String?            @unique
  pendingChange   AppointmentChange? @relation("PendingChange")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AppointmentChange {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  appointment   Appointment @relation("PendingChange", fields: [appointmentId], references: [id])

  newStartTime DateTime
  newEndTime   DateTime
  newStaffId   String?
  reason       String?

  isApproved Boolean @default(false)
  isRejected Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Message {
  id      String  @id @default(cuid())
  content String
  isRead  Boolean @default(false)

  senderId String
  sender   User   @relation("SentMessages", fields: [senderId], references: [id])

  receiverId String
  receiver   User   @relation("ReceivedMessages", fields: [receiverId], references: [id])

  createdAt DateTime @default(now())
}

model Blacklist {
  id     String  @id @default(cuid())
  reason String?

  barberId String
  barber   Profile @relation(fields: [barberId], references: [id])

  customerId String
  customer   User   @relation(fields: [customerId], references: [id])

  createdAt DateTime @default(now())

  @@unique([barberId, customerId])
}

model StaffRole {
  id          String  @id @default(cuid())
  name        String // Cirak, Kalfa, Usta
  description String?

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id])

  // Yetkiler
  canCreateAppointments Boolean @default(false)
  canEditAppointments   Boolean @default(false)
  canManageMessages     Boolean @default(false)
  canUpdateProfile      Boolean @default(false)
  canManageStaff        Boolean @default(false)

  staff Staff[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Staff {
  id    String  @id @default(cuid())
  name  String
  email String?
  phone String?
  image String?

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id])

  roleId String?
  role   StaffRole? @relation(fields: [roleId], references: [id])

  // Calisma saatleri (personel bazli, opsiyonel)
  workingHours StaffWorkingHour[]
  breaks       StaffBreak[]

  // Hizmetlere atanma
  serviceAssignments StaffServiceAssignment[]

  // Randevular
  appointments Appointment[]

  // Subscription appointments
  subscriptionAppointments SubscriptionAppointment[]

  // Vardiyalara atanma
  shifts Shift[]

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StaffWorkingHour {
  id        String  @id @default(cuid())
  dayOfWeek Int
  isClosed  Boolean @default(false)

  staffId String
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  shifts StaffShift[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([staffId, dayOfWeek])
}

model StaffShift {
  id        String @id @default(cuid())
  startTime String
  endTime   String

  staffWorkingHourId String
  staffWorkingHour   StaffWorkingHour @relation(fields: [staffWorkingHourId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model StaffBreak {
  id        String @id @default(cuid())
  startTime String
  endTime   String
  dayOfWeek Int

  staffId String
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

model StaffServiceAssignment {
  id String @id @default(cuid())

  staffId String
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([staffId, serviceId])
}

model Favorite {
  id String @id @default(cuid())

  customerId String
  customer   User   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  barberId String
  barber   Profile @relation(fields: [barberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([customerId, barberId])
}

model SubscriptionAppointment {
  id             String         @id @default(cuid())
  recurrenceType RecurrenceType // DAILY, WEEKLY, MONTHLY
  startDate      DateTime // First appointment date
  endDate        DateTime? // End date (null if unlimited)
  time           String // Time in "16:00" format
  dayOfWeek      Int? // For weekly: 0=Sunday, 1=Monday, ..., 6=Saturday
  dayOfMonth     Int? // For monthly: day 1-31

  customerId String
  customer   User   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  barberId String
  barber   Profile @relation(fields: [barberId], references: [id], onDelete: Cascade)

  staffId String? // Staff assignment (optional)
  staff   Staff?  @relation(fields: [staffId], references: [id], onDelete: SetNull)

  services Service[]

  // Exceptions (cancelled or rescheduled appointments)
  exceptions SubscriptionAppointmentException[]

  // Generated appointments
  generatedAppointments Appointment[]

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId, barberId, recurrenceType])
}

model SubscriptionAppointmentException {
  id String @id @default(cuid())

  subscriptionAppointmentId String
  subscriptionAppointment   SubscriptionAppointment @relation(fields: [subscriptionAppointmentId], references: [id], onDelete: Cascade)

  originalDate  DateTime // Original appointment date
  exceptionType String // "CANCELLED" or "RESCHEDULED"
  newDate       DateTime? // New date if RESCHEDULED
  newTime       String? // New time if RESCHEDULED

  createdAt DateTime @default(now())

  @@unique([subscriptionAppointmentId, originalDate])
}

model Package {
  id           String   @id @default(cuid())
  name         String
  description  String?
  price        Decimal
  durationDays Int
  features     String[] // Array of strings for features
  isPopular    Boolean  @default(false)

  // Tax Info
  taxRate       Int     @default(20) // %
  isTaxIncluded Boolean @default(true)

  isActive Boolean @default(true)

  subscriptions       SubscriptionHistory[]
  promoCodes          PromoCode[]
  paymentTransactions PaymentTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PromoCode {
  id              String    @id @default(cuid())
  code            String    @unique
  discountPercent Int?
  discountAmount  Decimal?
  durationDays    Int? // e.g. 90 for 3 months trial
  maxUses         Int?
  usedCount       Int       @default(0)
  expiresAt       DateTime?
  isActive        Boolean   @default(true)

  validPackageId String?
  validPackage   Package? @relation(fields: [validPackageId], references: [id])

  subscriptions SubscriptionHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SupportTicket {
  id       String         @id @default(cuid())
  subject  String
  message  String
  status   TicketStatus   @default(OPEN)
  priority TicketPriority @default(NORMAL)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  messages TicketMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TicketMessage {
  id      String  @id @default(cuid())
  content String
  isAdmin Boolean @default(false) // If true, sent by admin

  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

model PaymentTransaction {
  id       String  @id @default(cuid())
  orderId  String  @unique
  amount   Decimal
  currency String  @default("TRY")
  status   String // SUCCESS, FAILURE
  provider String  @default("WEBDETEK")

  transactionId String? // From provider
  rawResponse   Json? // Full response from provider

  userId String
  user   User   @relation(fields: [userId], references: [id])

  packageId String?
  package   Package? @relation(fields: [packageId], references: [id])

  errorReason String?

  createdAt DateTime @default(now())
}
